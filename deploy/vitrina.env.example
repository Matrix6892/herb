# Copy to /etc/vitrina/vitrina.env (mode 600, outside the repository) and fill
# in. Loaded by the systemd units in deploy/systemd (spec §9).

# Affiliate network product feed. Secret: it usually carries an account key.
VITRINA_FEED_URL=

# Uploads the verified build. Runs with $VITRINA_SITE_DIR set to the site
# directory and $VITRINA_BUILD_DATE to its date. Example for Cloudflare Pages:
#   VITRINA_UPLOAD_CMD='npx --yes wrangler@3 pages deploy "$VITRINA_SITE_DIR" --project-name=vitrina --branch=main'
# (needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID below).
VITRINA_UPLOAD_CMD=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# edge-api
VITRINA_DB=/srv/vitrina/var/vitrina.db
VITRINA_API_ADDR=127.0.0.1:8081
# Behind Cloudflare the client address arrives in this header. The address is
# used only for the in-memory rate limit and is never stored.
VITRINA_CLIENT_IP_HEADER=CF-Connecting-IP
VITRINA_SESSION_SALT=
# Only if the API is served from another origin than the pages.
VITRINA_ALLOWED_ORIGIN=

# Owner notifications (deploy/notify.sh) and monitoring (deploy/monitor.sh).
VITRINA_NOTIFY_EMAIL=
VITRINA_SITE_URL=https://vitrina.example
VITRINA_CATEGORY_SLUG=magnesium

# Backups (deploy/backup.sh): an rclone remote in the chosen jurisdiction (И9).
VITRINA_BACKUP_REMOTE=
VITRINA_BACKUP_DAYS=90
